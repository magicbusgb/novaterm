{
  "name": "novaterm",
  "version": "1.0.0",
  "description": "Client SSH/terminale moderno in stile MobaXterm con SFTP, import CSV e Claude Code integrato",
  "main": "src/main/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.328",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.18",
    "marked": "^18.2.1",
    "node-pty": "^1.1.0",
    "papaparse": "^5.7.1",
    "ssh2": "^1.17.0"
  },
  "productName": "NovaTerm",
  "build": {
    "appId": "dev.novaterm.app",
    "productName": "NovaTerm",
    "files": [
      "src/**/*",
      "node_modules/**/*",
      "build/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-pty/**",
      "node_modules/@anthropic-ai/claude-agent-sdk*/**"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development"
    }
  },
  "devDependencies": {
    "electron": "^39.8.10"
  }
}
